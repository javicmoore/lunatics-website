# Copia este archivo como .env y llena los valores. Nunca subas .env a Git.
#
# IMPORTANTE: toda variable con prefijo VITE_ se incrusta en el JavaScript
# público y CUALQUIERA puede leerla desde el navegador. Úsalas solo para datos
# públicos. Las llaves privadas (p. ej. el Access Token de Mercado Pago) deberán
# vivir únicamente en el backend / variables de servidor de Vercel, sin VITE_.

# URL pública del sitio (para Open Graph absoluto y canonical)
VITE_SITE_URL=

# --- Fase futura (no usar todavía) ---
# VITE_MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ACCESS_TOKEN=        # solo servidor, jamás con prefijo VITE_
